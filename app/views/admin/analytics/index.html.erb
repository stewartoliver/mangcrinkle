<% content_for :title, "Analytics Dashboard" %>

<!-- Lifetime Stats Section -->
<div class="mb-8">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Total Revenue -->
    <div class="bg-white shadow rounded-lg border border-orange-200 p-6">
      <div class="flex items-center">
        <div class="p-3 bg-green-100 rounded-full">
          <svg class="h-6 w-6 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-600">Total Revenue</h3>
          <p class="text-2xl font-semibold text-green-950">$<%= number_with_precision(@lifetime_stats[:total_revenue], precision: 2) %></p>
        </div>
      </div>
    </div>

    <!-- Total Orders -->
    <div class="bg-white shadow rounded-lg border border-orange-200 p-6">
      <div class="flex items-center">
        <div class="p-3 bg-orange-100 rounded-full">
          <svg class="h-6 w-6 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-600">Total Orders</h3>
          <p class="text-2xl font-semibold text-orange-950"><%= @lifetime_stats[:total_orders] %></p>
        </div>
      </div>
    </div>

    <!-- Total Customers -->
    <div class="bg-white shadow rounded-lg border border-orange-200 p-6">
      <div class="flex items-center">
        <div class="p-3 bg-blue-100 rounded-full">
          <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-600">Total Customers</h3>
          <p class="text-2xl font-semibold text-blue-950"><%= @lifetime_stats[:total_customers] %></p>
        </div>
      </div>
    </div>

    <!-- Total Products -->
    <div class="bg-white shadow rounded-lg border border-orange-200 p-6">
      <div class="flex items-center">
        <div class="p-3 bg-purple-100 rounded-full">
          <svg class="h-6 w-6 text-purple-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-600">Total Products</h3>
          <p class="text-2xl font-semibold text-purple-950"><%= @lifetime_stats[:total_products] %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Long-term Trends Section -->
<div class="mb-8">  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Monthly Revenue Trend -->
    <div class="bg-white shadow rounded-lg border border-orange-200">
      <div class="px-6 py-4 border-b border-orange-200">
        <h3 class="text-lg font-medium text-orange-950">Monthly Revenue Trend</h3>
        <p class="text-sm text-orange-600">12-month revenue overview</p>
      </div>
      <div class="p-6">
        <div style="height: 300px;">
          <%= column_chart @lifetime_stats[:revenue_by_month], 
              colors: ["#ea580c"],
              height: "300px",
              library: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                  y: {
                    beginAtZero: true,
                    ticks: {
                      callback: "function(value) { return '$' + value.toLocaleString(); }"
                    },
                    grid: {
                      color: "rgba(0,0,0,0.1)"
                    }
                  },
                  x: {
                    grid: {
                      color: "rgba(0,0,0,0.1)"
                    }
                  }
                },
                plugins: {
                  legend: {
                    display: false
                  }
                }
              } %>
        </div>
      </div>
    </div>

    <!-- Customer Growth -->
    <div class="bg-white shadow rounded-lg border border-orange-200">
      <div class="px-6 py-4 border-b border-orange-200">
        <h3 class="text-lg font-medium text-orange-950">Customer Growth</h3>
        <p class="text-sm text-orange-600">Monthly new customer acquisition</p>
      </div>
      <div class="p-6">
        <div style="height: 300px;">
          <%= line_chart @lifetime_stats[:customer_growth], 
              colors: ["#ea580c"],
              height: "300px",
              curve: true,
              points: false,
              library: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                  y: {
                    beginAtZero: true,
                    ticks: {
                      stepSize: 1
                    },
                    grid: {
                      color: "rgba(0,0,0,0.1)"
                    }
                  },
                  x: {
                    grid: {
                      color: "rgba(0,0,0,0.1)"
                    }
                  }
                },
                plugins: {
                  legend: {
                    display: false
                  }
                }
              } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Enhanced Date Range Filter -->
<div class="bg-white shadow rounded-lg border border-orange-200 mb-8">
  <div class="px-6 py-5 border-b border-orange-200">
    <h3 class="text-lg font-medium text-orange-950">Date Range Selection</h3>
    <p class="text-sm text-orange-600 mt-1">Choose your analysis period or use preset ranges</p>
  </div>
  
  <div class="p-6">
    <!-- Preset Date Ranges -->
    <div class="mb-6">
      <h4 class="text-sm font-medium text-orange-700 mb-3">Quick Select</h4>
      <div class="flex flex-wrap gap-2">
        <% @preset_ranges.each do |key, range| %>
          <%= link_to admin_analytics_path(start_date: range[:start], end_date: range[:end_date]), 
              class: "px-3 py-2 text-sm font-medium rounded-md border transition-colors duration-200 #{params[:start_date] == range[:start].to_s && params[:end_date] == range[:end_date].to_s ? 'bg-orange-100 border-orange-300 text-orange-900' : 'border-orange-200 text-orange-700 hover:bg-orange-50'}" do %>
            <%= range[:label] %>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Custom Date Range Form -->
    <%= form_with url: admin_analytics_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |form| %>
      <div class="flex-1 min-w-48">
        <label class="block text-sm font-medium text-orange-700 mb-1">Start Date</label>
        <%= form.date_field :start_date, value: @start_date, class: "form-date" %>
      </div>
      <div class="flex-1 min-w-48">
        <label class="block text-sm font-medium text-orange-700 mb-1">End Date</label>
        <%= form.date_field :end_date, value: @end_date, class: "form-date" %>
      </div>
      <div class="flex gap-2">
        <%= form.submit "Update Analytics", class: "admin-btn admin-btn-primary" %>
        <%= link_to "Reset to Last 30 Days", admin_analytics_path, class: "admin-btn admin-btn-secondary" %>
      </div>
    <% end %>
    
    <!-- Export Options -->
    <div class="mt-6 pt-6 border-t border-orange-200">
      <h4 class="text-sm font-medium text-orange-700 mb-3">Export Sales Reports</h4>
      <div class="flex flex-wrap gap-2">
        <%= link_to admin_analytics_export_path(start_date: @start_date, end_date: @end_date, format: 'pdf'), 
            class: "px-4 py-2 text-sm font-medium rounded-md border border-red-200 text-red-700 hover:bg-red-50 transition-colors duration-200" do %>
          <svg class="w-4 h-4 mr-2 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Export Sales PDF
        <% end %>
        <%= link_to admin_analytics_export_path(start_date: @start_date, end_date: @end_date, format: 'csv'), 
            class: "px-4 py-2 text-sm font-medium rounded-md border border-green-200 text-green-700 hover:bg-green-50 transition-colors duration-200" do %>
          <svg class="w-4 h-4 mr-2 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Export Sales CSV
        <% end %>
      </div>
      <p class="text-xs text-orange-500 mt-2">Professional sales reports perfect for bank loan applications and investor presentations</p>
    </div>
  </div>
</div>

<!-- Period-Specific Stats Section -->
<div class="mb-8">
  <h2 class="text-2xl font-bold text-orange-950 mb-6"><%= @start_date.strftime("%B %d, %Y") %> - <%= @end_date.strftime("%B %d, %Y") %></h2>
  
  <!-- Key Metrics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Period Revenue -->
    <div class="bg-white shadow rounded-lg border border-orange-200 p-6">
      <div class="flex items-center">
        <div class="p-3 bg-green-100 rounded-full">
          <svg class="h-6 w-6 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-600">Period Revenue</h3>
          <p class="text-2xl font-semibold text-green-950">$<%= number_with_precision(@period_stats[:revenue], precision: 2) %></p>
          <% if @comparison_stats[:revenue_change] != 0 %>
            <p class="text-sm <%= @comparison_stats[:revenue_change] >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= @comparison_stats[:revenue_change] >= 0 ? '+' : '' %><%= @comparison_stats[:revenue_change] %>%
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Period Orders -->
    <div class="bg-white shadow rounded-lg border border-orange-200 p-6">
      <div class="flex items-center">
        <div class="p-3 bg-orange-100 rounded-full">
          <svg class="h-6 w-6 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-600">Period Orders</h3>
          <p class="text-2xl font-semibold text-orange-950"><%= @period_stats[:orders] %></p>
          <% if @comparison_stats[:orders_change] != 0 %>
            <p class="text-sm <%= @comparison_stats[:orders_change] >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= @comparison_stats[:orders_change] >= 0 ? '+' : '' %><%= @comparison_stats[:orders_change] %>%
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Average Order Value -->
    <div class="bg-white shadow rounded-lg border border-orange-200 p-6">
      <div class="flex items-center">
        <div class="p-3 bg-blue-100 rounded-full">
          <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-sm font-medium text-gray-600">Avg Order Value</h3>
          <p class="text-2xl font-semibold text-blue-950">$<%= number_with_precision(@period_stats[:average_order_value], precision: 2) %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Revenue Chart -->
    <div class="admin-container">
      <div class="admin-container-header">
        <h3 class="admin-container-title">Revenue Trend</h3>
        <p class="admin-container-subtitle">Daily revenue for the selected period</p>
      </div>
      <div class="admin-container-content">
        <div class="p-6">
          <div style="height: 400px;">
            <%= line_chart @period_stats[:revenue_by_day], 
                colors: ["#ea580c"],
                height: "400px",
                curve: true,
                points: false,
                library: {
                  responsive: true,
                  maintainAspectRatio: false,
                  scales: {
                    y: {
                      beginAtZero: true,
                      ticks: {
                        callback: "function(value) { return '$' + value.toLocaleString(); }"
                      },
                      grid: {
                        color: "rgba(0,0,0,0.1)"
                      }
                    },
                    x: {
                      grid: {
                        color: "rgba(0,0,0,0.1)"
                      }
                    }
                  },
                  plugins: {
                    legend: {
                      display: false
                    }
                  }
                } %>
          </div>
          
          <!-- Summary -->
          <div class="flex items-center justify-between p-4 bg-gradient-to-r from-orange-50 to-orange-100 rounded-lg border border-orange-200 mt-6 mb-4">
            <div class="flex items-center space-x-4">
              <div class="flex-shrink-0">
                <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
              <div>
                <div class="text-sm font-medium text-orange-700">Period Total</div>
                <div class="text-2xl font-bold text-orange-900">$<%= number_with_precision(@period_stats[:revenue], precision: 2) %></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Orders Chart -->
    <div class="admin-container">
      <div class="admin-container-header">
        <h3 class="admin-container-title">Orders Trend</h3>
        <p class="admin-container-subtitle">Daily order count for the selected period</p>
      </div>
      <div class="admin-container-content">
        <div class="p-6">
          <div style="height: 400px;">
            <%= line_chart @period_stats[:orders_by_day], 
                colors: ["#ea580c"],
                height: "400px",
                curve: true,
                points: false,
                library: {
                  responsive: true,
                  maintainAspectRatio: false,
                  scales: {
                    y: {
                      beginAtZero: true,
                      ticks: {
                        stepSize: 1
                      },
                      grid: {
                        color: "rgba(0,0,0,0.1)"
                      }
                    },
                    x: {
                      grid: {
                        color: "rgba(0,0,0,0.1)"
                      }
                    }
                  },
                  plugins: {
                    legend: {
                      display: false
                    }
                  }
                } %>
          </div>
          
          <!-- Summary -->
          <div class="flex items-center justify-between p-4 bg-gradient-to-r from-orange-50 to-orange-100 rounded-lg border border-orange-200 mt-6 mb-4">
            <div class="flex items-center space-x-4">
              <div class="flex-shrink-0">
                <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                </div>
              </div>
              <div>
                <div class="text-sm font-medium text-orange-700">Period Total</div>
                <div class="text-2xl font-bold text-orange-900"><%= @period_stats[:orders] %> orders</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Additional Charts -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Order Status Breakdown -->
    <div class="bg-white shadow rounded-lg border border-orange-200">
      <div class="px-6 py-4 border-b border-orange-200">
        <h3 class="text-lg font-medium text-orange-950">Order Status</h3>
        <p class="text-sm text-orange-600">Breakdown by order status</p>
      </div>
      <div class="p-6">
        <%= pie_chart @period_stats[:orders_by_status], 
            colors: ["#f59e0b", "#3b82f6", "#10b981", "#ef4444"],
            library: {
              plugins: {
                legend: {
                  position: 'bottom'
                }
              }
            } %>
      </div>
    </div>

    <!-- Orders by Source -->
    <div class="bg-white shadow rounded-lg border border-orange-200">
      <div class="px-6 py-4 border-b border-orange-200">
        <h3 class="text-lg font-medium text-orange-950">Orders by Source</h3>
        <p class="text-sm text-orange-600">Where orders are coming from</p>
      </div>
      <div class="p-6">
        <%= pie_chart @period_stats[:orders_by_source], 
            colors: ["#ea580c", "#8b5cf6", "#06b6d4"],
            library: {
              plugins: {
                legend: {
                  position: 'bottom'
                }
              }
            } %>
      </div>
    </div>
  </div>
</div>

<!-- Product and Customer Analytics -->
<div class="mb-8">
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Top Products -->
    <div class="admin-container">
      <div class="admin-container-header">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="admin-container-title">Top Products</h3>
            <p class="admin-container-subtitle">Most ordered products in this period</p>
          </div>
          <%= link_to admin_products_path, class: "admin-btn admin-btn-primary" do %>
            <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            View All
          <% end %>
        </div>
      </div>
      <div class="admin-container-content">
        <table class="admin-table">
          <thead class="admin-table-header">
            <tr>
              <th scope="col" class="admin-table-header-cell">Product</th>
              <th scope="col" class="admin-table-header-cell-center">Orders</th>
              <th scope="col" class="admin-table-header-cell-right">Rank</th>
            </tr>
          </thead>
          <tbody class="admin-table-body">
            <% if @product_analytics[:top_products].any? %>
              <% @product_analytics[:top_products].each_with_index do |(product_name, count), index| %>
                <tr class="admin-table-row">
                  <td class="admin-table-cell">
                    <div class="flex items-center">
                      <div class="product-avatar">
                        <% 
                          # Try to find the product to get its image
                          product = Product.find_by(name: product_name)
                          if product&.has_image?
                        %>
                          <%= image_tag product.image, class: "product-avatar-image" %>
                        <% else %>
                          <div class="product-avatar-placeholder">
                            <span class="product-avatar-initial"><%= product_name.first.upcase %></span>
                          </div>
                        <% end %>
                      </div>
                      <div class="product-info">
                        <div class="product-name"><%= product_name %></div>
                      </div>
                    </div>
                  </td>
                  <td class="admin-table-cell-center">
                    <span class="text-sm font-medium text-orange-950"><%= count %></span>
                  </td>
                  <td class="admin-table-cell-right">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-700">
                      #<%= index + 1 %>
                    </span>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr class="admin-table-row">
                <td colspan="3" class="admin-table-cell text-center py-8">
                  <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  </div>
                  <p class="text-orange-600 font-medium">No product data available</p>
                  <p class="text-sm text-orange-500 mt-1">for this period</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Top Customers -->
    <div class="admin-container">
      <div class="admin-container-header">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="admin-container-title">Top Customers</h3>
            <p class="admin-container-subtitle">Most frequent customers in this period</p>
          </div>
          <%= link_to admin_users_path, class: "admin-btn admin-btn-primary" do %>
            <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            View All
          <% end %>
        </div>
      </div>
      <div class="admin-container-content">
        <table class="admin-table">
          <thead class="admin-table-header">
            <tr>
              <th scope="col" class="admin-table-header-cell">Customer</th>
              <th scope="col" class="admin-table-header-cell-center">Orders</th>
              <th scope="col" class="admin-table-header-cell-center">Total Revenue</th>
              <th scope="col" class="admin-table-header-cell-right">Rank</th>
            </tr>
          </thead>
          <tbody class="admin-table-body">
            <% if @customer_analytics[:top_customers].any? %>
              <% @customer_analytics[:top_customers].each_with_index do |customer, index| %>
                <tr class="admin-table-row">
                  <td class="admin-table-cell">
                    <div>
                      <div class="text-sm font-medium text-orange-950">
                        <% if customer[:first_name].present? || customer[:last_name].present? %>
                          <%= [customer[:first_name], customer[:last_name]].compact.join(' ') %>
                        <% else %>
                          <%= customer[:email] %>
                        <% end %>
                      </div>
                      <div class="text-xs text-orange-600"><%= customer[:email] %></div>
                    </div>
                  </td>
                  <td class="admin-table-cell-center">
                    <span class="text-sm font-medium text-orange-950"><%= customer[:order_count] %></span>
                  </td>
                  <td class="admin-table-cell-center">
                    <span class="text-sm font-semibold text-green-600">$<%= number_with_precision(customer[:total_revenue], precision: 2) %></span>
                  </td>
                  <td class="admin-table-cell-right">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-700">
                      #<%= index + 1 %>
                    </span>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr class="admin-table-row">
                <td colspan="3" class="admin-table-cell text-center py-8">
                  <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-orange-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                  </div>
                  <p class="text-orange-600 font-medium">No customer data available</p>
                  <p class="text-sm text-orange-500 mt-1">for this period</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  // Add any additional JavaScript for the analytics page
  console.log('Analytics dashboard loaded');
});
</script> 