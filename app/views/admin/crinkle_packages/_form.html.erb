<%= form_with(model: [:admin, crinkle_package], class: "space-y-8") do |f| %>
  <% if crinkle_package.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(crinkle_package.errors.count, "error") %> prohibited this package from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% crinkle_package.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Basic Information Section -->
  <div class="bg-white border border-orange-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-orange-950 mb-4 border-b border-orange-100 pb-2">
      Basic Information
    </h3>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="lg:col-span-2">
        <%= f.label :name, "Package Name", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", placeholder: "Enter the package name" %>
      </div>
      
      <div class="lg:col-span-2">
        <%= f.label :description, "Short Description", class: "form-label" %>
        <%= f.text_field :description, class: "form-input", placeholder: "A brief, catchy description..." %>
      </div>
      
      <div>
        <%= f.label :price, "Price ($)", class: "form-label" %>
        <div class="mt-1 relative rounded-md shadow-sm">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-orange-500 text-sm font-medium">$</span>
          </div>
          <%= f.number_field :price, step: 0.01, min: 0, class: "form-input pl-7 pr-12", placeholder: "0.00" %>
        </div>
      </div>
      
      <div>
        <%= f.label :quantity, "Item Limit", class: "form-label" %>
        <%= f.number_field :quantity, min: 1, class: "form-input", placeholder: "1" %>
      </div>
    </div>

    <!-- Holiday Package Settings Subsection -->
    <div class="mt-8 pt-6 border-t border-orange-100">
      <div class="flex items-center justify-between mb-4">
        <h4 class="text-lg font-semibold text-orange-950 cursor-pointer" id="holiday-toggle">
          Holiday Package Settings
          <svg id="holiday-toggle-icon" class="w-4 h-4 ml-2 inline transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </h4>
      </div>
      
      <div id="holiday-section" class="<%= 'hidden' unless crinkle_package.holiday_package? %>">
        <div class="space-y-4">
          <div class="relative flex items-start">
            <div class="flex items-center h-5">
              <%= f.check_box :holiday_package, class: "form-checkbox", id: "holiday_package_checkbox" %>
            </div>
            <div class="ml-3 text-sm">
              <%= f.label :holiday_package, "This is a holiday package", class: "font-medium text-orange-700", for: "holiday_package_checkbox" %>
              <p class="text-orange-600 text-xs mt-1">Check this if this package is only available during specific holidays</p>
            </div>
          </div>
          
          <div id="holiday-dates" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :holiday_start_date, "Holiday Start Date", class: "form-label" %>
              <p class="text-xs text-orange-600 mb-2">When this package becomes available</p>
              <div class="mt-1">
                <%= f.date_field :holiday_start_date, class: "form-date" %>
              </div>
            </div>
            
            <div>
              <%= f.label :holiday_end_date, "Holiday End Date", class: "form-label" %>
              <p class="text-xs text-orange-600 mb-2">When this package stops being available</p>
              <div class="mt-1">
                <%= f.date_field :holiday_end_date, class: "form-date" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Package Products Section -->
  <div class="bg-white border border-orange-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-orange-950 mb-4 border-b border-orange-100 pb-2">
      Package Products
    </h3>
    <p class="text-sm text-orange-600 mb-6">Configure which products are available in this package and their default settings.</p>
    
    <!-- Products by Category -->
    <% Product.available_categories.each do |category| %>
      <% category_products = @products.select { |p| p.category == category } %>
      <% next if category_products.empty? %>
      
      <div class="border border-orange-200 rounded-lg mb-6">
        <div class="bg-orange-50 px-4 py-3 border-b border-orange-200">
          <h4 class="text-lg font-semibold text-orange-950"><%= category %></h4>
        </div>
        
        <div class="p-4">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            <% category_products.each do |product| %>
              <% package_product = @package_products.find { |pp| pp.product_id == product.id } %>
              <div class="border border-orange-200 rounded-lg p-3 hover:bg-orange-50 transition-colors">
                <div class="flex items-start space-x-3">
                  <!-- Product Image -->
                  <div class="flex-shrink-0">
                    <% if product.primary_image %>
                      <%= image_tag product.primary_image, alt: product.name, class: "w-10 h-10 object-cover rounded-lg" %>
                    <% else %>
                      <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
                        <span class="text-orange-600 font-medium text-xs"><%= product.name.first.upcase %></span>
                      </div>
                    <% end %>
                  </div>
                  
                  <!-- Product Info -->
                  <div class="flex-1 min-w-0">
                    <h5 class="font-medium text-orange-950 truncate text-sm"><%= product.name %></h5>
                    <p class="text-xs text-orange-600"><%= product.formatted_price %></p>
                    
                    <!-- Controls -->
                     <div class="mt-2 flex flex-col md:flex-row md:items-center md:justify-between space-y-1 md:space-y-0">
                       <div class="space-y-1">
                         <div class="flex items-center space-x-2">
                           <%= hidden_field_tag "package_products[#{product.id}][active]", "0" %>
                           <%= check_box_tag "package_products[#{product.id}][active]", 
                               "1", package_product&.active == true, 
                               { class: "form-checkbox", id: "package_products_#{product.id}_active" } %>
                           <%= label_tag "package_products_#{product.id}_active", "Include", 
                               class: "text-xs font-medium text-orange-700" %>
                         </div>
                         
                         <div class="flex items-center space-x-2">
                           <%= hidden_field_tag "package_products[#{product.id}][required]", "0" %>
                           <%= check_box_tag "package_products[#{product.id}][required]", 
                               "1", package_product&.required == true, 
                               { class: "form-checkbox", id: "package_products_#{product.id}_required" } %>
                           <%= label_tag "package_products_#{product.id}_required", "Required", 
                               class: "text-xs text-orange-600" %>
                         </div>
                       </div>
 
                       <div class="flex items-center space-x-2 md:ml-4">
                         <%= label_tag "package_products_#{product.id}_quantity", "Qty:", 
                             class: "text-xs text-orange-600" %>
                         <%= number_field_tag "package_products[#{product.id}][quantity]", 
                             package_product&.quantity || 0, 
                             { min: 0, class: "form-input w-12 text-xs h-6", id: "package_products_#{product.id}_quantity" } %>
                       </div>
                     </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Status Section -->      
    <div class="admin-status-section">
      <div class="admin-status-info">
        <h4 class="admin-status-title">Package Availability</h4>
        <p class="admin-status-description">
          Control whether customers can see and purchase this package
        </p>
        <div class="mt-2 space-y-1">
          <div class="flex items-center text-xs text-orange-600">
            <span class="inline-block w-2 h-2 bg-green-500 rounded-full mr-2"></span>
            <span><strong>Active:</strong> Visible to customers, available for purchase</span>
          </div>
          <div class="flex items-center text-xs text-orange-600">
            <span class="inline-block w-2 h-2 bg-gray-400 rounded-full mr-2"></span>
            <span><strong>Inactive:</strong> Hidden from customers, draft mode</span>
          </div>
        </div>
      </div>
      
      <div class="admin-status-toggle">
        <label class="admin-toggle-switch">
          <%= f.check_box :active, class: "admin-toggle-input", checked: crinkle_package.new_record? ? true : crinkle_package.active? %>
          <span class="admin-toggle-slider"></span>
          <span class="admin-toggle-labels">
            <span class="admin-toggle-active">Active</span>
            <span class="admin-toggle-inactive">Inactive</span>
          </span>
        </label>
      </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex justify-end space-x-3 pt-6 border-t border-orange-200">
    <%= link_to "Cancel", admin_crinkle_packages_path, class: "admin-btn-secondary" %>
    <%= f.submit class: "admin-btn-primary" %>
  </div>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
// Holiday Package Form - Simple and Reliable Implementation
function initializeHolidayPackageForm() {
  console.log('Holiday Package Form: Initializing...');
  
  const holidayToggle = document.getElementById('holiday-toggle');
  const holidaySection = document.getElementById('holiday-section');
  const holidayCheckbox = document.getElementById('holiday_package_checkbox');
  const holidayDates = document.getElementById('holiday-dates');
  const holidayPresets = document.getElementById('holiday-presets');
  const toggleIcon = document.getElementById('holiday-toggle-icon');

  console.log('Holiday Package Form: Elements found:', {
    holidayToggle: !!holidayToggle,
    holidaySection: !!holidaySection,
    holidayCheckbox: !!holidayCheckbox,
    holidayDates: !!holidayDates,
    holidayPresets: !!holidayPresets,
    toggleIcon: !!toggleIcon
  });

  // Holiday toggle functionality - based on admin navigation pattern
  if (holidayToggle && holidaySection && toggleIcon) {
    console.log('Holiday Package Form: Setting up toggle functionality');
    
    holidayToggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      console.log('Holiday Package Form: Toggle clicked');
      
      // Toggle the section visibility
      holidaySection.classList.toggle('hidden');
      
      // Update icon rotation
      if (holidaySection.classList.contains('hidden')) {
        toggleIcon.classList.remove('chevron-rotated');
        toggleIcon.classList.add('chevron-normal');
        console.log('Holiday Package Form: Section hidden');
      } else {
        toggleIcon.classList.remove('chevron-normal');
        toggleIcon.classList.add('chevron-rotated');
        console.log('Holiday Package Form: Section shown');
      }
    });
  } else {
    console.log('Holiday Package Form: Required elements not found!');
  }

  // Handle holiday checkbox change
  if (holidayCheckbox && holidayDates && holidayPresets) {
    holidayCheckbox.addEventListener('change', function() {
      if (holidayCheckbox.checked) {
        // Show presets when checkbox is checked
        holidayPresets.classList.remove('hidden');
      } else {
        // Hide presets when checkbox is unchecked
        holidayPresets.classList.add('hidden');
      }
    });
  }

  // Holiday preset buttons
  const presetButtons = document.querySelectorAll('.holiday-preset-btn');
  presetButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const preset = e.target.dataset.preset;
      const holidayPresetsData = {
        christmas: { start: '2024-12-01', end: '2024-12-31' },
        valentines: { start: '2025-02-01', end: '2025-02-14' },
        easter: { start: '2025-03-15', end: '2025-04-20' },
        mothers: { start: '2025-05-01', end: '2025-05-11' }
      };
      
      const presetData = holidayPresetsData[preset];
      if (presetData) {
        const startDateField = document.querySelector('input[name="crinkle_package[holiday_start_date]"]');
        const endDateField = document.querySelector('input[name="crinkle_package[holiday_end_date]"]');
        
        if (startDateField) startDateField.value = presetData.start;
        if (endDateField) endDateField.value = presetData.end;
      }
    });
  });
}

// Initialize on multiple events to ensure it works
document.addEventListener('DOMContentLoaded', initializeHolidayPackageForm);
document.addEventListener('turbo:load', initializeHolidayPackageForm);
document.addEventListener('turbo:render', initializeHolidayPackageForm);

// Fallback initialization after a delay
setTimeout(initializeHolidayPackageForm, 500);
</script>
