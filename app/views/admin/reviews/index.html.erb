<% content_for :title, "Reviews Management" %>

<!-- Statistics Dashboard -->
<div class="flex flex-wrap gap-4 mb-6">
  <div class="admin-stats-card flex-1 min-w-0">
    <div class="flex items-center">
      <div class="admin-stats-icon admin-stats-icon-orange">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
      </div>
      <div class="admin-stats-content">
        <h2 class="admin-stats-label">Total Reviews</h2>
        <p class="admin-stats-value admin-stats-value-orange"><%= @stats[:total] %></p>
      </div>
    </div>
  </div>

  <div class="admin-stats-card flex-1 min-w-0">
    <div class="flex items-center">
      <div class="admin-stats-icon admin-stats-icon-green">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="admin-stats-content">
        <h2 class="admin-stats-label">Approved</h2>
        <p class="admin-stats-value admin-stats-value-green"><%= @stats[:approved] %></p>
      </div>
    </div>
  </div>

  <div class="admin-stats-card flex-1 min-w-0">
    <div class="flex items-center">
      <div class="admin-stats-icon admin-stats-icon-yellow">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="admin-stats-content">
        <h2 class="admin-stats-label">Pending</h2>
        <p class="admin-stats-value admin-stats-value-yellow"><%= @stats[:pending] %></p>
      </div>
    </div>
  </div>

  <div class="admin-stats-card flex-1 min-w-0">
    <div class="flex items-center">
      <div class="admin-stats-icon admin-stats-icon-blue">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      <div class="admin-stats-content">
        <h2 class="admin-stats-label">Featured</h2>
        <p class="admin-stats-value admin-stats-value-blue"><%= @stats[:featured] %></p>
      </div>
    </div>
  </div>
</div>

<!-- Reviews Management -->
<div class="admin-container" data-tab-container="reviews" data-paginated="true">
  <div class="admin-container-header">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="admin-container-title">Customer Reviews</h3>
        <p class="admin-container-subtitle">Manage and moderate customer reviews for your products.</p>
      </div>
      <div class="flex items-center space-x-3">
        <%= link_to "Generate Review Link", quick_link_admin_review_invites_path, class: "admin-btn-secondary" %>
        <%= link_to "Manage Invitations", admin_review_invites_path, class: "admin-btn-secondary" %>
        <%= link_to "View Public Reviews", reviews_path, class: "admin-btn-primary", target: "_blank" %>
      </div>
    </div>
  </div>

  <!-- Search and Filters -->
  <%= form_with url: admin_reviews_path, method: :get, local: true, id: "search-form", class: "px-6 py-4 border-b border-orange-200 bg-gray-50" do |form| %>
    
    <div class="flex flex-wrap gap-4">
      <div class="flex-1 min-w-0">
        <%= form.label :search, "Search", class: "form-label" %>
        <div class="mt-1">
          <%= form.text_field :search, placeholder: "Search by customer name or content...", 
                              value: params[:search], class: "form-input" %>
        </div>
      </div>
      
      <div class="flex-1 min-w-0">
        <%= form.label :rating, "Rating", class: "form-label" %>
        <div class="mt-1">
          <%= form.select :rating, 
                          options_for_select([
                            ['All Ratings', ''],
                            ['5 Stars', '5'],
                            ['4 Stars', '4'],
                            ['3 Stars', '3'],
                            ['2 Stars', '2'],
                            ['1 Star', '1']
                          ], params[:rating]), 
                          {}, { class: "form-select" } %>
        </div>
      </div>
      
      <div class="flex items-end">
        <%= form.submit "Filter", class: "admin-btn-primary" %>
        <%= link_to "Clear", admin_reviews_path, class: "ml-2 admin-btn-secondary" %>
      </div>
    </div>
  <% end %>

  <!-- Status Filter Tabs -->
  <div class="border-b border-orange-200">
    <nav class="flex space-x-8 px-6" aria-label="Tabs">
      <% 
        all_count = @stats[:total] || 0
        pending_count = @stats[:pending] || 0
        approved_count = @stats[:approved] || 0
        featured_count = @stats[:featured] || 0
        
        # Only show tabs that have data
        statuses_with_data = []
        statuses_with_data << 'pending' if pending_count > 0
        statuses_with_data << 'approved' if approved_count > 0
        statuses_with_data << 'featured' if featured_count > 0
        
        show_all_tab = statuses_with_data.length > 1
        current_tab = params[:status] || 'all'
      %>
      
      <% if show_all_tab %>
        <button class="tab-button <%= current_tab == 'all' ? 'active' : '' %>" data-tab="all" data-container-type="reviews">
          All Reviews (<%= all_count %>)
        </button>
      <% end %>
      
      <% if pending_count > 0 %>
        <button class="tab-button <%= (show_all_tab ? '' : 'active') + (current_tab == 'pending' ? ' active' : '') %>" data-tab="pending" data-container-type="reviews">
          Pending (<%= pending_count %>)
        </button>
      <% end %>
      
      <% if approved_count > 0 %>
        <button class="tab-button <%= (show_all_tab ? '' : 'active') + (current_tab == 'approved' ? ' active' : '') %>" data-tab="approved" data-container-type="reviews">
          Approved (<%= approved_count %>)
        </button>
      <% end %>
      
      <% if featured_count > 0 %>
        <button class="tab-button <%= (show_all_tab ? '' : 'active') + (current_tab == 'featured' ? ' active' : '') %>" data-tab="featured" data-container-type="reviews">
          Featured (<%= featured_count %>)
        </button>
      <% end %>
    </nav>
  </div>

  <!-- Reviews Table -->
  <div class="admin-container-content">
    <table class="admin-table">
      <thead class="admin-table-header">
        <tr>
          <th scope="col" class="admin-table-header-cell">Review</th>
          <th scope="col" class="admin-table-header-cell-center">Rating</th>
          <th scope="col" class="admin-table-header-cell-center">Status</th>
          <th scope="col" class="admin-table-header-cell-center">Date</th>
          <th scope="col" class="admin-table-header-cell-right">Actions</th>
        </tr>
      </thead>
      <tbody class="admin-table-body">
        <% @reviews.each do |review| %>
          <tr class="admin-table-row" 
              data-review-id="<%= review.id %>" 
              data-status="<%= review.featured? ? 'featured' : (review.approved? ? 'approved' : 'pending') %>">
            <td class="admin-table-cell">
              <div class="flex items-start">
                <div class="product-info">
                  <div class="product-name flex items-center">
                    <%= review.customer_display_name %>
                    <% if review.featured? %>
                      <svg class="ml-2 h-4 w-4 text-orange-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    <% end %>
                  </div>
                  <% if review.user.present? %>
                    <div class="product-description">
                      Customer • <%= review.email %>
                    </div>
                  <% else %>
                    <div class="product-description">
                      Guest • <%= review.email %>
                    </div>
                  <% end %>
                  <div class="admin-list-item-meta">
                    <% if review.title.present? %>
                      <strong>"<%= truncate(review.title, length: 50) %>"</strong><br>
                    <% end %>
                    <%= truncate(review.content, length: 120) %>
                  </div>
                  <% if review.admin_notes.present? %>
                    <div class="mt-2 text-xs text-orange-500">
                      <strong>Admin Notes:</strong> <%= truncate(review.admin_notes, length: 80) %>
                    </div>
                  <% end %>
                </div>
              </div>
            </td>
            <td class="admin-table-cell-center">
              <div class="flex items-center justify-center">
                <% 5.times do |i| %>
                  <svg class="h-4 w-4 <%= i < review.rating ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                <% end %>
                <span class="ml-1 text-sm text-orange-600">(<%= review.rating %>)</span>
              </div>
            </td>
            <td class="admin-table-cell-center">
              <div class="flex flex-col items-center space-y-1">
                <% if review.featured? %>
                  <span class="admin-status-badge bg-blue-100 text-blue-800 font-semibold flex items-center justify-center">
                    <svg class="w-3 h-3 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Featured
                  </span>
                <% elsif review.approved? %>
                  <span class="admin-status-badge bg-green-100 text-green-800 flex items-center justify-center">
                    <svg class="w-3 h-3 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    Approved
                  </span>
                <% else %>
                  <span class="admin-status-badge bg-yellow-100 text-yellow-800 flex items-center justify-center">
                    <svg class="w-3 h-3 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    Pending
                  </span>
                <% end %>
                <% if review.verified_purchase? %>
                  <span class="admin-status-badge bg-purple-100 text-purple-800 text-xs flex items-center justify-center">
                    <svg class="w-3 h-3 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    Verified
                  </span>
                <% end %>
              </div>
            </td>
            <td class="admin-table-cell-center text-sm text-orange-600">
              <div class="flex flex-col items-center">
                <span><%= review.created_at.strftime("%b %d, %Y") %></span>
                <span class="text-xs text-gray-500"><%= review.created_at.strftime("%I:%M %p") %></span>
              </div>
            </td>
            <td class="admin-table-cell-right">
              <div class="admin-action-btn-group">
                <!-- Review Expand Toggle Button -->
                <button type="button" 
                        class="review-expand-toggle admin-action-btn" 
                        data-review-id="<%= review.id %>"
                        title="Expand Review Details">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                
                <%= link_to admin_review_path(review), class: "admin-action-btn", title: "View Details" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                <% end %>
                
                <% if review.approved? %>
                  <%= link_to unapprove_admin_review_path(review), 
                              class: "admin-action-btn review-unapprove", 
                              title: "Unapprove Review" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  <% end %>
                <% else %>
                  <%= link_to approve_admin_review_path(review), 
                              class: "admin-action-btn review-approve", 
                              title: "Approve Review" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  <% end %>
                <% end %>

                <% if review.featured? %>
                  <%= link_to toggle_featured_admin_review_path(review), 
                              class: "admin-action-btn review-unfeature",
                              title: "Remove from Featured" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  <% end %>
                <% elsif review.can_be_featured? %>
                  <%= link_to toggle_featured_admin_review_path(review), 
                              class: "admin-action-btn review-feature",
                              title: "Add to Featured" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  <% end %>
                <% else %>
                  <span class="admin-action-btn review-disabled" title="Review must be approved before it can be featured">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  </span>
                <% end %>

                <%= button_to admin_review_path(review), 
                            class: "admin-action-btn-danger",
                            title: "Delete Review" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
          
          <!-- Expandable Review Details Row -->
          <tr class="review-expand-details review-row-collapsed" data-review-id="<%= review.id %>">
            <td colspan="5" class="px-6 py-4 bg-orange-50 border-t border-orange-200">
              <div class="max-w-sm mx-auto">
                <div class="bg-white rounded-lg border border-orange-200 shadow-sm p-4">
                <div class="flex items-center mb-3">
                  <div class="text-lg text-orange-600 mr-2">
                    <% review.rating.times do %>★<% end %>
                    <% (5 - review.rating).times do %>☆<% end %>
                  </div>
                  <span class="text-sm text-orange-500">(<%= review.rating %>)</span>
                </div>
                <% if review.title.present? %>
                  <h6 class="font-semibold text-orange-950 mb-2">"<%= review.title %>"</h6>
                <% end %>
                <p class="text-orange-700 mb-3 text-sm leading-relaxed">"<%= review.content %>"</p>
                <p class="font-semibold text-orange-950">- <%= review.customer_display_name %></p>
                <% if review.verified_purchase? %>
                  <p class="text-xs text-orange-600 mt-2">✓ Verified Purchase</p>
                <% end %>
                                 <div class="mt-3 text-xs text-orange-500">
                   <%= review.created_at.strftime("%B %d, %Y") %>
                 </div>
               </div>
             </div>
           </td>
         </tr>
        <% end %>
      </tbody>
    </table>
    
    <% if @reviews.empty? %>
      <div class="text-center py-12">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No reviews found</h3>
        <p class="text-gray-500 mb-4">
          <% if params[:search].present? || params[:status].present? || params[:rating].present? %>
            No reviews match your search criteria.
          <% else %>
            Customer reviews will appear here once they start submitting them.
          <% end %>
        </p>
        <%= link_to "View Public Reviews Page", reviews_path, class: "admin-btn-primary", target: "_blank" %>
      </div>
    <% end %>
  </div>

  <!-- Count Display -->
  <div class="px-6 py-3 border-t border-orange-200 bg-orange-50">
    <div class="flex items-center justify-between">
      <div class="text-sm text-orange-600">
        Showing <span id="visible-count"><%= @reviews.count %></span> of <span id="total-count"><%= @filtered_reviews_count %></span> results
      </div>
      <div class="text-sm text-orange-600">
        Use tabs above to filter results
      </div>
    </div>
  </div>

  <!-- Pagination Controls -->
  <% if @reviews.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-orange-200 bg-orange-50">
      <div class="flex items-center justify-between">
        <div class="text-sm text-orange-600">
          Page <%= @reviews.current_page %> of <%= @reviews.total_pages %> (<%= @filtered_reviews_count %> total results)
        </div>
        <div class="flex items-center space-x-2">
          <% if @reviews.prev_page %>
            <%= link_to "Previous", admin_reviews_path(page: @reviews.prev_page, status: @current_tab, search: params[:search], rating: params[:rating]), class: "admin-btn-secondary" %>
          <% end %>
          
          <% if @reviews.next_page %>
            <%= link_to "Next", admin_reviews_path(page: @reviews.next_page, status: @current_tab, search: params[:search], rating: params[:rating]), class: "admin-btn-secondary" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div> 